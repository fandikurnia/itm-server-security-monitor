#!/usr/bin/env bash

# ============================================================
# ITM Server Security Monitor
# Post-Compromise Security Audit and Hardening Monitor
#
# AUDIT ONLY.
#
# This command inspects the host and reports. It never kills a
# process, deletes a file, disables a service, installs a
# package or edits an Nginx, PHP or PAM configuration.
#
# Usage:
#   itm-security audit                 all modules
#   itm-security audit process         one or more modules
#   itm-security audit --json          JSON array on stdout
#   itm-security audit --telegram      alert on HIGH/CRITICAL
#   itm-security audit --dry-run       nothing written, nothing sent
#   itm-security self-test             readiness check
# ============================================================

set -uo pipefail

# ------------------------------------------------------------
# Locate the library and modules
#
# Installed layout is used when present; otherwise the layout
# of a git checkout, so the tool can be exercised without
# installing anything.
# ------------------------------------------------------------

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"

ITM_LIB_DIR="${ITM_LIB_DIR:-/usr/local/lib/itm-security}"

if [[ ! -r "$ITM_LIB_DIR/itm-audit-common.sh" ]]; then
    if [[ -r "$SCRIPT_DIR/../lib/itm-audit-common.sh" ]]; then
        ITM_LIB_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
        ITM_MODULE_DIR="$ITM_LIB_DIR/modules"
        ITM_LIB_DIR="$ITM_LIB_DIR/lib"
    else
        echo "[ERROR] itm-audit-common.sh not found. Looked in:" >&2
        echo "        $ITM_LIB_DIR" >&2
        echo "        $SCRIPT_DIR/../lib" >&2
        exit 1
    fi
fi

ITM_MODULE_DIR="${ITM_MODULE_DIR:-$ITM_LIB_DIR/modules}"

# shellcheck source=../lib/itm-audit-common.sh
source "$ITM_LIB_DIR/itm-audit-common.sh"

# ------------------------------------------------------------
# Module registry
#
# Order matters: nginx runs before php and web, because both
# consume the document roots and fastcgi targets it discovers.
# ------------------------------------------------------------

# role runs first: every web content module asks it whether
# this host has a web application workload before touching the
# filesystem. nginx runs before php/web/webshell because those
# consume the document roots and FastCGI targets it discovers.
ITM_ALL_MODULES="role health process network pam systemd cron command ioc datadir sshd ssh_session nginx apache php web webshell gambling seo integrity fail2ban"

module_file() {
    case "$1" in
        role)     printf '%s' "audit_role.sh" ;;
        health)   printf '%s' "audit_health.sh" ;;
        process)  printf '%s' "audit_process.sh" ;;
        network)  printf '%s' "audit_network.sh" ;;
        pam)      printf '%s' "audit_pam.sh" ;;
        systemd)  printf '%s' "audit_systemd.sh" ;;
        cron)     printf '%s' "audit_cron.sh" ;;
        command)  printf '%s' "audit_command.sh" ;;
        ioc)      printf '%s' "audit_ioc.sh" ;;
        datadir)  printf '%s' "audit_datadir.sh" ;;
        sshd)     printf '%s' "audit_sshd.sh" ;;
        ssh_session) printf '%s' "audit_ssh_session.sh" ;;
        nginx)    printf '%s' "audit_nginx.sh" ;;
        apache)   printf '%s' "audit_apache.sh" ;;
        php)      printf '%s' "audit_php.sh" ;;
        web)      printf '%s' "audit_web.sh" ;;
        webshell) printf '%s' "audit_webshell.sh" ;;
        gambling) printf '%s' "audit_gambling.sh" ;;
        seo)      printf '%s' "audit_seo.sh" ;;
        integrity) printf '%s' "audit_integrity.sh" ;;
        fail2ban) printf '%s' "audit_fail2ban.sh" ;;
        *)        return 1 ;;
    esac
}

usage() {
    cat <<'EOF'
ITM Server Security Monitor - post-compromise audit

Usage:
  itm-security audit [module ...] [options]
  itm-security health | doctor
  itm-security heartbeat
  itm-security web <baseline|changes|status|realtime>
  itm-security remediate [module ...] [--min-severity SEV]
  itm-security self-test
  itm-security version
  itm-security help

Modules:
  role        host role detection - decides which modules apply
  health      is the MONITOR itself alive: services, timers, missed
              runs, inotify capacity, self-integrity
  process     running process integrity, deleted and fileless executables
  network     listeners, exposure policy, root owned outbound sessions
  pam         PAM stack integrity, pam_exec credential capture
  systemd     malicious unit persistence
  cron        reverse shells and downloaders in scheduled tasks
  command     wrapper binaries hiding processes, ports and files
  ioc         unpackaged binaries in system directories, known IOC
              paths/hashes/domains, ld.so.preload injection
  datadir     world-writable data directories, and the ones that
              hold raw database files
  sshd        effective sshd config: root login, password auth,
              MaxAuthTries, client alive (recommendations only)
  ssh_session SSH session inventory and maximum duration control
              (monitor_only by default; enforce terminates)
  nginx       PHP execution in upload/data document roots
  apache      DocumentRoot exposure, .htaccess/.user.ini handlers,
              AllowOverride, CGI, mod_remoteip real client IP
  php         PHP-FPM versions, pools and production settings
  web         web filesystem: webshells, artefacts, permissions
  fail2ban    service, jail, backend and SSH port coverage

  Web content modules (skipped as NOT APPLICABLE unless this
  host actually runs a web application):

  webshell    webshells, upload abuse, writable PHP directories,
              access-log correlation, web-spawned interpreters
  gambling    judi/slot injection scored by keyword density and
              file provenance
  seo         SEO poisoning, cloaking, doorway pages, hijacked
              canonical/robots/sitemap, Japanese keyword hack
  integrity   source hash baseline: CREATED, MODIFIED, DELETED,
              OWNER_CHANGED, PERMISSION_CHANGED

  With no module named, every module runs.

Incident response:
  remediate      run an audit, then generate one evidence-first response
                 script per finding under /root/forensic/incident-<time>/.
                 Generating changes nothing. Each script preserves evidence
                 and only contains the threat when re-run with CONFIRM=yes.

  triage         same as "remediate --interactive": generate the pack and then
                 walk every finding, deciding one at a time whether it is
                 legitimate. Each decision and its reason is written to
                 DECISIONS.log so it can be read back months later.

Web subcommands:
  web baseline   (re)build the source integrity baseline
  web changes    integrity comparison only
  web status     web security status board
  web realtime   run the realtime inotify monitor in the foreground

Options:
  --json              print findings as a JSON array on stdout
  --telegram          send HIGH/CRITICAL findings to Telegram (deduplicated)
  --min-severity SEV  Telegram threshold: INFO LOW MEDIUM HIGH CRITICAL
  --dry-run           run everything, write nothing, send nothing
  --quiet             suppress the human readable report
  --no-log            do not append to the log and JSON files
  --conf FILE         use an alternative audit.conf
  -h, --help          this help

Exit codes:
  0  no finding at or above MEDIUM
  1  usage or environment error
  2  HIGH findings present
  3  CRITICAL findings present

This command is read only. It never kills a process, deletes a
file, disables a service or edits a configuration.
EOF
}

# ------------------------------------------------------------
# Self test
# ------------------------------------------------------------

self_test() {

    local failures=0 warnings=0

    printf '\n'
    printf '============================================================\n'
    printf ' ITM Security Audit - self test\n'
    printf '============================================================\n\n'

    check_line() {
        local label="$1" state="$2" detail="${3:-}"
        printf '%-34s %-8s %s\n' "$label" "$state" "$detail"
    }

    # ---- library and modules ----
    check_line "Library" "OK" "$ITM_LIB_DIR/itm-audit-common.sh"

    local m file
    for m in $ITM_ALL_MODULES; do
        file="$ITM_MODULE_DIR/$(module_file "$m")"
        if [[ ! -r "$file" ]]; then
            check_line "Module $m" "MISSING" "$file"
            failures=$(( failures + 1 ))
        elif bash -n "$file" 2>/dev/null; then
            check_line "Module $m" "OK" "syntax valid"
        else
            check_line "Module $m" "ERROR" "syntax error in $file"
            failures=$(( failures + 1 ))
        fi
    done

    # ---- privileges ----
    if is_root; then
        check_line "Privileges" "OK" "running as root"
    else
        check_line "Privileges" "WARN" "not root - process, PAM and web checks will be partial"
        warnings=$(( warnings + 1 ))
    fi

    # ---- configuration ----
    if [[ -r "$ITM_AUDIT_CONF" ]]; then
        check_line "audit.conf" "OK" "$ITM_AUDIT_CONF"
    else
        check_line "audit.conf" "WARN" "not found, built-in defaults apply"
        warnings=$(( warnings + 1 ))
    fi

    if (( ${#TRUSTED_NETWORKS[@]} > 0 )); then
        check_line "Trusted networks" "OK" "${#TRUSTED_NETWORKS[@]} entries"
    else
        check_line "Trusted networks" "WARN" "$ITM_TRUSTED_NET_CONF not readable"
        warnings=$(( warnings + 1 ))
    fi

    check_line "Host trust status" "INFO" "$HOST_TRUST_STATUS"

    # ---- output paths ----
    if mkdir -p "$ITM_LOG_DIR" 2>/dev/null && [[ -w "$ITM_LOG_DIR" ]]; then
        check_line "Log directory" "OK" "$ITM_LOG_DIR"
    else
        check_line "Log directory" "WARN" "$ITM_LOG_DIR not writable"
        warnings=$(( warnings + 1 ))
    fi

    if mkdir -p "$ITM_STATE_DIR" 2>/dev/null && [[ -w "$ITM_STATE_DIR" ]]; then
        check_line "State directory" "OK" "$ITM_STATE_DIR"
    else
        check_line "State directory" "WARN" "$ITM_STATE_DIR not writable - dedup disabled"
        warnings=$(( warnings + 1 ))
    fi

    # ---- Telegram ----
    if [[ -x "$ITM_NOTIFY_BIN" ]]; then
        check_line "Telegram notifier" "OK" "$ITM_NOTIFY_BIN"
    else
        check_line "Telegram notifier" "WARN" "$ITM_NOTIFY_BIN not executable"
        warnings=$(( warnings + 1 ))
    fi

    # Presence only. The credentials themselves are never read
    # or printed by the audit tooling.
    if [[ -r "$ITM_CONF_DIR/telegram.conf" ]]; then
        check_line "Telegram config" "OK" "present (contents not read)"
    else
        check_line "Telegram config" "WARN" "not readable by this user"
        warnings=$(( warnings + 1 ))
    fi

    # ---- external commands ----
    local c
    for c in ss find grep awk sed sha256sum stat readlink timeout; do
        if have_cmd "$c"; then
            check_line "Command: $c" "OK" ""
        else
            check_line "Command: $c" "WARN" "missing - related checks degrade"
            warnings=$(( warnings + 1 ))
        fi
    done

    for c in systemctl nginx php fail2ban-client dpkg-query rpm journalctl; do
        if have_cmd "$c"; then
            check_line "Command: $c" "OK" ""
        else
            check_line "Command: $c" "INFO" "not present - module will report SKIPPED"
        fi
    done

    printf '\n'
    printf 'OS family : %s (%s %s)\n' "$ITM_OS_FAMILY" "$ITM_OS_ID" "$ITM_OS_VERSION"
    printf 'Host      : %s (%s)\n' "$ITM_HOSTNAME" "$ITM_PRIVATE_IP"
    printf 'Version   : %s\n' "$ITM_AUDIT_VERSION"
    printf '\n'

    if (( failures > 0 )); then
        printf 'RESULT: NOT READY - %d failure(s), %d warning(s)\n\n' "$failures" "$warnings"
        return 1
    fi

    printf 'RESULT: READY - %d warning(s)\n' "$warnings"
    printf 'Run a full audit without writing anything:\n'
    printf '  itm-security audit --dry-run\n\n'
    return 0
}

# ------------------------------------------------------------
# Web subcommands
#
# These are thin wrappers over the same modules the audit uses,
# so there is exactly one implementation of each check.
# ------------------------------------------------------------

web_command() {

    local sub="${1:-status}"
    shift || true

    audit_load_config
    audit_init_color
    audit_detect_os
    audit_detect_host

    case "$sub" in

        realtime)
            # Run the watcher in the foreground. systemd runs the
            # same binary as itm-web-realtime.service.
            local rt="/usr/local/sbin/itm-web-realtime"
            [[ -x "$rt" ]] || rt="$SCRIPT_DIR/itm-web-realtime"
            if [[ ! -x "$rt" ]]; then
                say_err "[ERROR] itm-web-realtime not found."
                return 1
            fi
            exec "$rt"
            ;;

        baseline)
            audit_runtime_init
            trap audit_runtime_cleanup EXIT
            # shellcheck disable=SC1090
            source "$ITM_LIB_DIR/itm-web-common.sh"
            # shellcheck disable=SC1090
            source "$ITM_MODULE_DIR/audit_role.sh"
            # shellcheck disable=SC1090
            source "$ITM_MODULE_DIR/audit_integrity.sh"

            if ! role_is web_application; then
                printf '\nNo web application workload on this host (%s).\n' "$(role_summary_line)"
                printf 'Nothing to baseline.\n\n'
                return 0
            fi

            printf '\nBuilding web source integrity baseline...\n\n'
            web_baseline_rebuild
            return $?
            ;;

        changes)
            run_audit role integrity
            return $?
            ;;

        status)
            ITM_WEB_STATUS_MODE=1
            run_audit role nginx apache php webshell gambling seo integrity
            return $?
            ;;

        *)
            say_err "[ERROR] Unknown web subcommand: $sub"
            say_err "Valid: baseline changes status realtime"
            return 1
            ;;
    esac
}

# ------------------------------------------------------------
# Monitor health
#
# Exit codes are meaningful so a remote check can consume them:
#   0 HEALTHY   1 DEGRADED   2 BROKEN
# ------------------------------------------------------------

health_command() {

    local telegram=0 arg
    for arg in "$@"; do
        case "$arg" in
            --telegram) telegram=1 ;;
            --quiet|-q) ITM_QUIET=1 ;;
        esac
    done

    audit_load_config
    audit_init_color
    audit_detect_os
    audit_detect_host

    ITM_TELEGRAM="$telegram"
    ITM_HEALTH_MODE=1

    run_audit health
    local rc=$?

    case "${HEALTH_STATE:-HEALTHY}" in
        BROKEN)   return 2 ;;
        DEGRADED) return 1 ;;
    esac
    return 0
}

# ------------------------------------------------------------
# Audit driver
# ------------------------------------------------------------

run_audit() {

    local requested=("$@")
    local modules=() m file

    if (( ${#requested[@]} == 0 )); then
        # shellcheck disable=SC2206
        modules=( $ITM_ALL_MODULES )
    else
        # Preserve registry order regardless of argument order,
        # so nginx always runs before php and web.
        for m in $ITM_ALL_MODULES; do
            local want
            for want in "${requested[@]}"; do
                [[ "$want" == "$m" ]] && modules+=("$m") && break
            done
        done
    fi

    if (( ${#modules[@]} == 0 )); then
        say_err "[ERROR] No valid module selected."
        say_err "Valid modules: $ITM_ALL_MODULES"
        return 1
    fi

    audit_runtime_init

    # The role module and the web helpers are always loaded, not
    # only when selected: every web content module calls
    # require_web_workload() before it touches the filesystem,
    # so "itm-security audit webshell" on its own must still be
    # able to ask what kind of host this is.
    if [[ -r "$ITM_LIB_DIR/itm-web-common.sh" ]]; then
        # shellcheck disable=SC1090
        source "$ITM_LIB_DIR/itm-web-common.sh"
    fi
    if [[ -r "$ITM_MODULE_DIR/audit_role.sh" ]]; then
        # shellcheck disable=SC1090
        source "$ITM_MODULE_DIR/audit_role.sh"
    fi
    if (( ${ITM_REMEDIATE:-0} )) && [[ -r "$ITM_LIB_DIR/itm-remediate.sh" ]]; then
        # shellcheck disable=SC1090
        source "$ITM_LIB_DIR/itm-remediate.sh"
    fi

    # A signal handler that only cleans up would let the script
    # carry on with its temporary directory removed. Interrupt
    # means stop.
    trap audit_runtime_cleanup EXIT
    trap 'audit_runtime_cleanup; say_err "[WARN] Audit interrupted - partial results discarded."; exit 130' INT
    trap 'audit_runtime_cleanup; say_err "[WARN] Audit terminated - partial results discarded."; exit 143' TERM

    audit_log INFO "audit start run_id=$ITM_RUN_ID modules=${modules[*]} version=$ITM_AUDIT_VERSION"

    if (( ITM_QUIET == 0 )); then
        say ""
        say "${C_BOLD}ITM post-compromise audit${C_RESET} - $(date '+%Y-%m-%d %H:%M:%S %Z')"
        say "${C_DIM}host=$ITM_HOSTNAME modules=${modules[*]} mode=$( (( ITM_DRY_RUN )) && echo dry-run || echo normal )${C_RESET}"
    fi

    for m in "${modules[@]}"; do

        file="$ITM_MODULE_DIR/$(module_file "$m")"

        if [[ ! -r "$file" ]]; then
            say_err "[WARN] Module file missing: $file"
            continue
        fi

        # shellcheck disable=SC1090
        source "$file"

        if ! declare -F "run_audit_$m" >/dev/null; then
            say_err "[WARN] Module $m did not define run_audit_$m"
            continue
        fi

        "run_audit_$m"
    done

    if [[ "${ITM_HEALTH_MODE:-0}" == "1" ]]; then
        health_board
    elif [[ "${ITM_WEB_STATUS_MODE:-0}" == "1" ]]; then
        web_status_board
    else
        audit_summary
    fi

    commit_json
    commit_seen_state
    telegram_dispatch

    # Record completion so the health module can detect a
    # monitoring gap. Written only on a real run.
    if (( ITM_DRY_RUN == 0 )); then
        scan_state_set "last-run:audit"
        case " ${modules[*]} " in
            *" webshell "*|*" gambling "*|*" seo "*|*" integrity "*)
                scan_state_set "last-run:web" ;;
        esac
    fi

    audit_log INFO "audit end run_id=$ITM_RUN_ID max_severity=$ITM_MAX_SEV findings=$ITM_FINDING_TOTAL"

    # Incident response pack. Generated from the findings of the
    # run that just completed, never from a stale report: acting
    # on a finding nobody re-verified is how production data gets
    # destroyed.
    if [[ "${ITM_REMEDIATE_MODE:-0}" == "1" ]]; then
        rem_generate "${REMEDIATE_MIN_SEVERITY:-HIGH}"

        # Interactive triage runs only with a terminal: it asks
        # questions, and a timer or a pipeline cannot answer them.
        if [[ "${ITM_TRIAGE_MODE:-0}" == "1" && -n "$REM_INCIDENT_DIR" ]]; then
            if [[ -t 0 && -x "$REM_INCIDENT_DIR/00-triage.sh" ]]; then
                "$REM_INCIDENT_DIR/00-triage.sh"
            elif [[ -x "$REM_INCIDENT_DIR/00-triage.sh" ]]; then
                say ""
                say "Interactive triage needs a terminal. Run it yourself:"
                say "  sudo bash $REM_INCIDENT_DIR/00-triage.sh"
            fi
        fi
    fi

    if (( ITM_JSON_MODE )); then
        emit_json_array
    fi

    audit_exit_code
}

# ------------------------------------------------------------
# Argument parsing
# ------------------------------------------------------------

main() {

    local command="${1:-help}"
    shift || true

    local scopes=()

    case "$command" in
        -h|--help|help)
            usage
            return 0
            ;;
        version|--version|-V)
            printf 'itm-security audit %s\n' "$ITM_AUDIT_VERSION"
            return 0
            ;;
        self-test|selftest)
            audit_load_config
            audit_detect_os
            audit_detect_host
            self_test
            return $?
            ;;
        audit)
            ;;
        web)
            web_command "$@"
            return $?
            ;;
        health|doctor)
            health_command "$@"
            return $?
            ;;
        heartbeat)
            # A periodic "still alive" message. Silence is the
            # signal: a remote checker (Zabbix, uptime monitor,
            # a second server) watches for the ABSENCE of this,
            # which is the only way to detect a monitor that was
            # removed rather than one that failed.
            audit_load_config
            audit_detect_os
            audit_detect_host
            if [[ -x "$ITM_NOTIFY_BIN" ]]; then
                "$ITM_NOTIFY_BIN" "💓 MONITOR HEARTBEAT

Version : ${ITM_AUDIT_VERSION}
Status  : monitoring active
Time    : $(date '+%Y-%m-%d %H:%M:%S %Z')

Absence of this message is itself an alert." >/dev/null 2>&1 \
                    && { printf 'heartbeat sent\n'; return 0; }
                printf 'heartbeat FAILED to send\n' >&2
                return 1
            fi
            printf 'notifier not installed\n' >&2
            return 1
            ;;
        remediate|incident-plan|recommend)
            ITM_REMEDIATE=1
            ITM_REMEDIATE_MODE=1
            ;;
        triage)
            # Generate the pack, then walk it interactively.
            ITM_REMEDIATE=1
            ITM_REMEDIATE_MODE=1
            ITM_TRIAGE_MODE=1
            ;;
        *)
            say_err "[ERROR] Unknown command: $command"
            say_err "Run 'itm-security help' for usage."
            return 1
            ;;
    esac

    while (( $# > 0 )); do
        case "$1" in
            --json)
                ITM_JSON_MODE=1
                ITM_QUIET=1
                ;;
            --telegram)
                ITM_TELEGRAM=1
                ;;
            --min-severity)
                shift || true
                TELEGRAM_MIN_SEVERITY_OVERRIDE="${1:-HIGH}"
                REMEDIATE_MIN_SEVERITY="${1:-HIGH}"
                ;;
            --interactive|-i)
                ITM_TRIAGE_MODE=1
                ;;
            --dry-run|--dryrun)
                ITM_DRY_RUN=1
                ;;
            --quiet|-q)
                ITM_QUIET=1
                ;;
            --no-log)
                ITM_WRITE_LOG=0
                ITM_NO_LOG=1
                ;;
            --conf)
                shift || true
                ITM_AUDIT_CONF="${1:-$ITM_AUDIT_CONF}"
                ;;
            -h|--help)
                usage
                return 0
                ;;
            -*)
                say_err "[ERROR] Unknown option: $1"
                return 1
                ;;
            *)
                if module_file "$1" >/dev/null 2>&1; then
                    scopes+=("$1")
                else
                    say_err "[ERROR] Unknown module: $1"
                    say_err "Valid modules: $ITM_ALL_MODULES"
                    return 1
                fi
                ;;
        esac
        shift || true
    done

    audit_load_config
    audit_init_color
    audit_detect_os
    audit_detect_host

    # Command line wins over audit.conf.
    if [[ -n "${TELEGRAM_MIN_SEVERITY_OVERRIDE:-}" ]]; then
        TELEGRAM_MIN_SEVERITY="${TELEGRAM_MIN_SEVERITY_OVERRIDE^^}"
    fi
    if [[ -n "${ITM_NO_LOG:-}" ]]; then
        ITM_WRITE_LOG=0
    fi

    run_audit ${scopes[@]+"${scopes[@]}"}
}

main "$@"
