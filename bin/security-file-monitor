#!/usr/bin/env bash
set -u

WATCH_PATHS=(
  "/etc/ssh"
  "/etc/passwd"
  "/etc/shadow"
  "/etc/group"
  "/etc/gshadow"
  "/etc/sudoers"
  "/etc/sudoers.d"
  "/etc/crontab"
  "/etc/cron.d"
  "/etc/systemd/system"
  "/lib/systemd/system"
  "/usr/lib/systemd/system"
  "/root/.ssh"
)

# Add .ssh directories for normal interactive users.
while IFS=: read -r user _ uid _ _ home shell; do
  [[ "$uid" =~ ^[0-9]+$ ]] || continue
  if (( uid >= 1000 )) && [[ "$shell" =~ (bash|sh|zsh)$ ]] && [[ -d "$home/.ssh" ]]; then
    WATCH_PATHS+=("$home/.ssh")
  fi
done < /etc/passwd

VALID_PATHS=()
for p in "${WATCH_PATHS[@]}"; do
  [[ -e "$p" ]] && VALID_PATHS+=("$p")
done

(( ${#VALID_PATHS[@]} > 0 )) || exit 0

inotifywait -m -r \
  -e create -e modify -e delete -e moved_to -e moved_from \
  --format '%T|%e|%w%f' \
  --timefmt '%Y-%m-%d %H:%M:%S' \
  "${VALID_PATHS[@]}" |
while IFS='|' read -r EVENT_TIME EVENT FILE; do
  case "$FILE" in
    *.swp|*.swx|*~|*.tmp|*.dpkg-new|*.dpkg-old) continue ;;
  esac

  case "$FILE" in
    */authorized_keys|*/authorized_keys2)
      SEVERITY="🔴 CRITICAL - SSH KEY CHANGE" ;;
    /etc/passwd|/etc/shadow|/etc/group|/etc/gshadow)
      SEVERITY="🔴 CRITICAL - ACCOUNT DATABASE CHANGE" ;;
    /etc/sudoers|/etc/sudoers.d/*)
      SEVERITY="🔴 CRITICAL - SUDO CHANGE" ;;
    /etc/systemd/system/*|/lib/systemd/system/*|/usr/lib/systemd/system/*)
      SEVERITY="🔴 CRITICAL - SYSTEMD CHANGE" ;;
    /etc/ssh/*)
      SEVERITY="🟠 HIGH - SSH CONFIG CHANGE" ;;
    /etc/crontab|/etc/cron.d/*)
      SEVERITY="🟠 HIGH - CRON CHANGE" ;;
    *)
      SEVERITY="🟡 WARNING - SYSTEM CHANGE" ;;
  esac

  LOGGED_USERS="$(who 2>/dev/null | awk '{print $1" "$2" "$5}' | head -10)"
  [[ -n "$LOGGED_USERS" ]] || LOGGED_USERS="none"

  MESSAGE="${SEVERITY}

Event : ${EVENT}
File  : ${FILE}
Time  : ${EVENT_TIME}

Logged users:
${LOGGED_USERS}"

  /usr/local/sbin/security-notify "$MESSAGE" || true
done
