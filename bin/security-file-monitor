#!/usr/bin/env bash
set -u

WATCH_PATHS=(
  "/etc/ssh"
  "/etc/passwd"
  "/etc/shadow"
  "/etc/group"
  "/etc/gshadow"
  "/etc/sudoers"
  "/etc/sudoers.d"
  "/etc/crontab"
  "/etc/cron.d"
  "/etc/systemd/system"
  "/lib/systemd/system"
  "/usr/lib/systemd/system"
  "/root/.ssh"

  # The monitor's own files. Removing or editing the security
  # tooling is itself a security event, and it is the first
  # thing an intruder does once they notice it.
  "/usr/local/sbin/security-notify"
  "/usr/local/sbin/ssh-login-alert"
  "/usr/local/sbin/security-file-monitor"
  "/usr/local/sbin/itm-command-relay"
  "/usr/local/sbin/itm-security"
  "/usr/local/sbin/itm-web-realtime"
  "/usr/local/lib/itm-security"
  "/etc/security-monitor"
)

# Add .ssh directories for normal interactive users.
while IFS=: read -r user _ uid _ _ home shell; do
  [[ "$uid" =~ ^[0-9]+$ ]] || continue
  if (( uid >= 1000 )) && [[ "$shell" =~ (bash|sh|zsh)$ ]] && [[ -d "$home/.ssh" ]]; then
    WATCH_PATHS+=("$home/.ssh")
  fi
done < /etc/passwd

VALID_PATHS=()
for p in "${WATCH_PATHS[@]}"; do
  [[ -e "$p" ]] && VALID_PATHS+=("$p")
done

(( ${#VALID_PATHS[@]} > 0 )) || exit 0

inotifywait -m -r \
  -e create -e modify -e delete -e moved_to -e moved_from \
  --format '%T|%e|%w%f' \
  --timefmt '%Y-%m-%d %H:%M:%S' \
  "${VALID_PATHS[@]}" |
# How long to wait before deciding that a vanished .wants symlink
# is really gone. systemctl recreates it within milliseconds.
FIM_WANTS_SETTLE="${FIM_WANTS_SETTLE:-3}"
FIM_LOG="${FIM_LOG:-/var/log/itm-security/file-monitor.log}"

fim_log() {
  local dir="${FIM_LOG%/*}"
  [[ -d "$dir" ]] || return 0
  printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$FIM_LOG" 2>/dev/null || true
}

# "systemctl enable" on an already-enabled unit REMOVES the
# .wants symlink and creates it again. inotify reports the
# removal, so every reinstall alerts CRITICAL - on every host in
# the fleet at once, for a change the operator just made.
#
# A deployment across ten servers then produces ten CRITICAL
# alerts about the monitor's own unit being deleted, which is
# exactly the alert nobody reads by the eleventh time.
#
# The distinction that matters is whether the symlink COMES BACK.
# A re-enable restores it within milliseconds; "systemctl disable"
# by an intruder does not restore it at all. So wait, look again,
# and only stay silent when the link is present AND still points
# at a unit file that exists.
fim_is_reenable() {
  local file="$1" event="$2" target

  case "$file" in
    */*.wants/*|*/*.requires/*) ;;
    *) return 1 ;;
  esac

  case "$event" in
    *DELETE*|*MOVED_FROM*) ;;
    *) return 1 ;;
  esac

  sleep "$FIM_WANTS_SETTLE"

  [[ -L "$file" ]] || return 1

  # A symlink that came back pointing at nothing is not a
  # working re-enable, and is worth reporting.
  target="$(readlink -f -- "$file" 2>/dev/null)" || return 1
  [[ -n "$target" && -e "$target" ]] || return 1

  return 0
}

while IFS='|' read -r EVENT_TIME EVENT FILE; do
  case "$FILE" in
    *.swp|*.swx|*~|*.tmp|*.dpkg-new|*.dpkg-old) continue ;;
  esac

  if fim_is_reenable "$FILE" "$EVENT"; then
    fim_log "re-enable: $FILE ($EVENT) - symlink restored, not alerting"
    continue
  fi

  case "$FILE" in
    */authorized_keys|*/authorized_keys2)
      SEVERITY="🔴 CRITICAL - SSH KEY CHANGE" ;;
    /etc/passwd|/etc/shadow|/etc/group|/etc/gshadow)
      SEVERITY="🔴 CRITICAL - ACCOUNT DATABASE CHANGE" ;;
    /etc/sudoers|/etc/sudoers.d/*)
      SEVERITY="🔴 CRITICAL - SUDO CHANGE" ;;
    /usr/local/sbin/security-*|/usr/local/sbin/itm-*|/usr/local/lib/itm-security/*|/etc/security-monitor/*)
      SEVERITY="🚨 CRITICAL - SECURITY MONITOR MODIFIED" ;;
    /etc/systemd/system/itm-*|/etc/systemd/system/security-file-monitor.service)
      SEVERITY="🚨 CRITICAL - SECURITY MONITOR UNIT CHANGED" ;;
    /etc/systemd/system/*|/lib/systemd/system/*|/usr/lib/systemd/system/*)
      SEVERITY="🔴 CRITICAL - SYSTEMD CHANGE" ;;
    /etc/ssh/*)
      SEVERITY="🟠 HIGH - SSH CONFIG CHANGE" ;;
    /etc/crontab|/etc/cron.d/*)
      SEVERITY="🟠 HIGH - CRON CHANGE" ;;
    *)
      SEVERITY="🟡 WARNING - SYSTEM CHANGE" ;;
  esac

  LOGGED_USERS="$(who 2>/dev/null | awk '{print $1" "$2" "$5}' | head -10)"
  [[ -n "$LOGGED_USERS" ]] || LOGGED_USERS="none"

  MESSAGE="${SEVERITY}

Event : ${EVENT}
File  : ${FILE}
Time  : ${EVENT_TIME}

Logged users:
${LOGGED_USERS}"

  /usr/local/sbin/security-notify "$MESSAGE" || true
done
