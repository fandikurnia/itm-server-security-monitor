#!/bin/bash

# ============================================================
# ITM Server Security Monitor
# Interactive Shell Command Monitor
# ============================================================
#
# Loaded globally from /etc/profile.d/sysadmin.sh
#
# Captures:
#   - username
#   - UID
#   - SSH source IP
#   - executed command
#
# Commands are written to system journal using logger.
# Telegram delivery is handled separately by:
#   itm-command-monitor.service
#
# ============================================================

if [[ $- == *i* ]]; then

export PROMPT_COMMAND='
history 1 | {
    read -r x cmd

    if [ -n "$cmd" ] && [ "$cmd" != "$LAST_LOGGED_CMD" ]; then

        username=$(whoami)
        uid=$(id -u)

        if [ -n "$SSH_CONNECTION" ]; then
            source_ip="${SSH_CONNECTION%% *}"
        else
            source_ip="LOCAL"
        fi

        # Redact common credentials before logging/sending.
        safe_cmd=$(printf "%s" "$cmd" | sed -E \
            -e "s/([Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]=)[^ ]+/\1[REDACTED]/g" \
            -e "s/([Tt][Oo][Kk][Ee][Nn]=)[^ ]+/\1[REDACTED]/g" \
            -e "s/([Ss][Ee][Cc][Rr][Ee][Tt]=)[^ ]+/\1[REDACTED]/g" \
            -e "s/([Aa][Pp][Ii][_-]?[Kk][Ee][Yy]=)[^ ]+/\1[REDACTED]/g")

        logger -t itm-command-monitor -- \
            "USER=${username} UID=${uid} SOURCE=${source_ip} COMMAND=${safe_cmd}"

        export LAST_LOGGED_CMD="$cmd"
    fi
}'
fi
